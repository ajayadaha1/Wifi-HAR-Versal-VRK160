# ---------------------------------------------------------------------------
# project_top.tcl - build the plain-Vivado VRK160 OFDM-receiver design end to end
# (RF-ADC -> wifi_ddc -> ofdm_fe -> ofdm_be -> CSI records -> DDR; DDR IQ playback
# into the same chain for bring-up without RF). No AI Engine graph: the AIE design
# is co-generated by v++ (aie/link.sh + aie/overlay_rf.tcl, sharing rf_frontend.tcl)
# because a plain-Vivado BD cannot emit the paired AIE<->PL shim solution (VCK190
# PROJECT_STATE #21/#22).
#
# The design itself lives in vrk160_ofdm_design.tcl (entry point build_ofdm_bd);
# this file only configures the project and drives the build. Files in this dir:
#   project_top.tcl          (this: project + IP catalog + build -> XSA)
#   vrk160_ofdm_design.tcl   (the block design; captured platform + hand-written half)
#   rf_frontend.tcl          (the RF front-end hierarchy, also used by the v++ overlay)
#   fix_pvt_sas.tcl          (impl hook: RF-DC 1.2 PVT_SAS cells have no site on xcvr1602 ES1)
#   vrk160_wifi_har_bd.tcl   (reference capture of the FULL v++-integrated BD, incl. AIE)
#   recreate_wifi_har_bd.tcl (re-creates + validates that BD in a plain Vivado project)
#
#   vivado -mode batch -source hw/scripts/project_top.tcl [-tclargs bd_only]
# PREREQ: hls/build_kernels.sh (populates hw/ip_repo with the HLS IPs).
# Output: hw/build/vrk160_ofdm_rx.xsa (fixed XSA, bitstream included).
# ---------------------------------------------------------------------------
set HERE    [file normalize [file dirname [info script]]]
set REPO_HW [file normalize $HERE/..]
set PART    xcvr1602-vsva2488-2MP-e-S-es1
set BOARD   xilinx.com:vrk160:part0:1.1
set PRJ_DIR $REPO_HW/build/vrk160_ofdm
set OUT_XSA $REPO_HW/build/vrk160_ofdm_rx.xsa
set JOBS    [expr {[info exists ::env(JOBS)] ? $::env(JOBS) : 16}]
set BD_ONLY [expr {[lsearch -exact $argv bd_only] >= 0}]

# xcvr1602 is an ES1 device.
catch {enable_beta_device xcvr16*}

# 1) project + IP catalog (HLS IPs exported by hls/build_kernels.sh)
create_project -force vrk160_ofdm $PRJ_DIR -part $PART
set_property board_part $BOARD [current_project]
set_property ip_repo_paths [list $REPO_HW/ip_repo] [current_project]
update_ip_catalog

# 2) block design (sourced only now: it checks the IP catalog)
source $HERE/vrk160_ofdm_design.tcl
build_ofdm_bd vrk160_ofdm

# 3) wrapper + output products
make_wrapper -files [get_files *vrk160_ofdm.bd] -top -import -force
update_compile_order -fileset sources_1
set_property top vrk160_ofdm_wrapper [get_filesets sources_1]
generate_target all [get_files *vrk160_ofdm.bd]
puts "BD_VALIDATE_OK"

if {$BD_ONLY} {
    puts "BD_ONLY: stopping before synthesis (drop the bd_only tclarg to build)."
    close_project
    return
}

# 4) synth + impl + XSA
launch_runs synth_1 -jobs $JOBS
wait_on_run synth_1
if {[get_property PROGRESS [get_runs synth_1]] ne "100%"} { error "synth_1 failed - see the run log" }
# vrf_data_converter 1.2 on xcvr1602 ES1: remove the 2 unplaceable PVT_SAS cells
set_property STEPS.OPT_DESIGN.TCL.PRE [file normalize $HERE/fix_pvt_sas.tcl] [get_runs impl_1]
launch_runs impl_1 -to_step write_device_image -jobs $JOBS
wait_on_run impl_1
if {[get_property PROGRESS [get_runs impl_1]] ne "100%"} { error "impl_1 failed - see the run log" }
open_run impl_1
report_timing_summary -file $REPO_HW/build/vrk160_ofdm_timing.rpt
report_utilization -file $REPO_HW/build/vrk160_ofdm_util.rpt
write_hw_platform -fixed -include_bit -force $OUT_XSA
puts "WROTE_XSA $OUT_XSA"
close_project
